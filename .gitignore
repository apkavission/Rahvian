# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
# Any other build output, including the one a verification build writes while
# the dev server keeps `.next`. Tailwind v4 finds its own sources and skips
# whatever git ignores -- an unignored build directory gets scanned, and the
# class-shaped strings inside it compile to CSS that will not parse.
/.next-*/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase
/supabase/.temp
/supabase/.branches

# editor
.vscode/
.idea/
*.swp
*.swo

# local-only notes
*.local.md

# tooling rule files some frameworks generate on build — ground rule 1
# forbids them in this repository, and Next.js writes them back on every
# `next dev` / `next build`, so they are ignored rather than fought with
AGENTS.md
CLAUDE.md

# the signed-in session the browser tests save
/e2e/.auth

# nightly database export, when written with --local
/backups

# Playwright output. A run artefact, not source — and `.last-run.json` changes
# on every run, which makes every commit look like it touched the tests.
/test-results/
/playwright-report/
