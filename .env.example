# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is git-ignored and must stay that way.
# Never put a real value in this file.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Canonical origin. Drives canonical URLs, sitemap, robots, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The client portal and task tracker — a separate application.
# This site links to it from the admin header; nothing else is shared.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3100


# --- Supabase --------------------------------------------------------------
# Project URL and anon key are public by design and safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key bypasses Row Level Security.
# Server-only. Never prefix with NEXT_PUBLIC_. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (media storage) -----------------------------------------
# The bucket is private. There is deliberately no public URL here: nothing in
# R2 is reachable from the internet directly, and every file is served through
# this application, which decides who may see it before it hands anything over.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Email (own SMTP, no third-party sending service) -----------------------
# Any SMTP server we control or have credentials for. Leave blank in
# development: the mailer logs the message instead of sending it, and a lead is
# still saved either way.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465, false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender address. SPF, DKIM and DMARC must be set on this domain before real
# sends, or the mail lands in spam.
EMAIL_FROM=
# Where new lead notifications go.
EMAIL_TO_ADMIN=

# Test recipient. Anything sent while testing — a form submission, a template
# preview, a bounce check — goes to kumarnitish4384@gmail.com. The owner's
# personal address is never used for testing, and never appears in seed or
# demo data. See docs/PROGRESS.md, standing rules.

# --- Spam protection (Cloudflare Turnstile) --------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase tooling (local only) ------------------------------------------
# Used by the Supabase CLI, not by the application at runtime.
# SUPABASE_ACCESS_TOKEN: a personal access token from the Supabase dashboard,
#   Account -> Access Tokens. Needed by `npm run db:types`.
# SUPABASE_DB_PASSWORD: the database password chosen when the project was
#   created. Needed for a direct psql connection.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Security --------------------------------------------------------------
# Random 32+ char string. Salts IP hashes so raw IPs are never stored.
IP_HASH_SALT=

# --- Analytics (optional until launch) -------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Cache invalidation ---------------------------------------------------
# Shared secret for POST /api/revalidate, and the fallback for the cron
# endpoints when CRON_SECRET is not set.
REVALIDATE_SECRET=

# --- Scheduled jobs --------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` and nothing else.
# Set this on Vercel; locally the endpoints accept x-cron-secret with
# REVALIDATE_SECRET instead, so this can stay blank here.
CRON_SECRET=

# --- Admin sign-in (local only, optional) -----------------------------------
# The owner account for /admin/login, so end-to-end tests can sign in without
# anyone typing a password from memory. Never read by the application at
# runtime — the password exists only as a hash in Supabase Auth.
#
# Leave blank unless you are running the browser tests locally.
ADMIN_EMAIL=
ADMIN_PASSWORD=
